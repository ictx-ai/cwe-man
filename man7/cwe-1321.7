.SH EXAMPLES
One vulnerable\->fixed pair per ecosystem (Node.js).
.SS Node.js
\fIVulnerable:\fR
.RS
.EX
function merge(t, s){ for (const k in s) t[k] = s[k]; return t; }  // __proto__
.EE
.RE
\fIFixed:\fR
.RS
.EX
function merge(t, s){
  for (const k in s) {
    if (k === '__proto__' || k === 'constructor' || k === 'prototype') continue;
    t[k] = s[k];
  }
  return t;
}
.EE
.RE
