.SH EXAMPLES
One vulnerable\->fixed pair per ecosystem (Node.js, Python, Java, Go, PHP).
.SS Node.js
\fIVulnerable:\fR
.RS
.EX
app.get('/hi', (req, res) =>
  res.send('<h1>Hello ' + req.query.name + '</h1>'));   // reflected XSS
.EE
.RE
\fIFixed:\fR
.RS
.EX
const escapeHtml = s => String(s).replace(/[&<>"']/g, c =>
  ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
app.get('/hi', (req, res) =>
  res.send('<h1>Hello ' + escapeHtml(req.query.name) + '</h1>'));
// Better: an auto-escaping template (e.g. <%= name %> in EJS).
.EE
.RE
.SS Python
\fIVulnerable:\fR
.RS
.EX
@app.get('/hi')
def hi():
